APP_NAME=MaintenanceApp API
ENVIRONMENT=dev
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REPOSITORY_BACKEND=postgres
COMPOSE_PROJECT_NAME=maintenance-dev
ENV_FILE_PATH=environments/dev/.env
POSTGRES_DB=maintenance_dev
POSTGRES_USER=maintenance_dev_user
POSTGRES_PASSWORD=replace-with-a-dev-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_HOST_PORT=5433
POSTGRES_VOLUME_NAME=maintenance_dev_postgres_data
POSTGRES_VOLUME_EXTERNAL=false
BACKEND_PORT=8001
STORAGE_HOST_PATH=./runtime/dev/storage
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=maintenance-app-dev
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ATTACHMENT_STORAGE_PATH=storage/attachments
ATTACHMENT_MAX_BYTES=10000000
REPORT_STORAGE_PATH=storage/reports
REPORT_LOGO_PATH=assets/Hitachi-Logo-v2.png
CALIBRATION_REPORT_FILE_PREFIX=Report_Calibration
