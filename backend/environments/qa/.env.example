APP_NAME=MaintenanceApp API
ENVIRONMENT=qa
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REPOSITORY_BACKEND=postgres
COMPOSE_PROJECT_NAME=maintenance-qa
ENV_FILE_PATH=environments/qa/.env
POSTGRES_DB=maintenance_qa
POSTGRES_USER=maintenance_qa_user
POSTGRES_PASSWORD=replace-with-a-qa-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_HOST_PORT=5434
POSTGRES_VOLUME_NAME=maintenance_qa_postgres_data
POSTGRES_VOLUME_EXTERNAL=false
BACKEND_PORT=8002
STORAGE_HOST_PATH=./runtime/qa/storage
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=maintenance-app-qa
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ATTACHMENT_STORAGE_PATH=storage/attachments
ATTACHMENT_MAX_BYTES=10000000
REPORT_STORAGE_PATH=storage/reports
REPORT_LOGO_PATH=assets/Hitachi-Logo-v2.png
CALIBRATION_REPORT_FILE_PREFIX=Report_Calibration
