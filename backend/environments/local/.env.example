APP_NAME=MaintenanceApp API
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REPOSITORY_BACKEND=postgres
COMPOSE_PROJECT_NAME=maintenance-local
ENV_FILE_PATH=environments/local/.env
POSTGRES_DB=maintenance_local
POSTGRES_USER=maintenance_local_user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_VOLUME_NAME=maintenance_local_postgres_data
POSTGRES_VOLUME_EXTERNAL=false
BACKEND_PORT=8000
STORAGE_HOST_PATH=./runtime/local/storage
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=maintenance-app-local
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ATTACHMENT_STORAGE_PATH=storage/attachments
ATTACHMENT_MAX_BYTES=10000000
REPORT_STORAGE_PATH=storage/reports
REPORT_LOGO_PATH=assets/Hitachi-Logo.png
PREVENTIVE_REPORT_FORMAT_CODE=ML2-STS-FOR-040-ES
PREVENTIVE_REPORT_REVISION=0
CORRECTIVE_REPORT_FORMAT_CODE=ML2-STS-FOR-041-ES
CORRECTIVE_REPORT_REVISION=0
CALIBRATION_REPORT_FILE_PREFIX=Report_Calibration
